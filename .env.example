# Flask
SECRET_KEY=change-me-to-a-random-secret-key-in-production
FLASK_ENV=development
FLASK_DEBUG=1

# Database
DEV_DATABASE_URL=mysql+pymysql://root:root@localhost/msms_dev
PROD_DATABASE_URL=mysql+pymysql://root:root@localhost/msms_prod
TEST_DATABASE_URL=mysql+pymysql://root:root@localhost/msms_test

# Mail Settings
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_DEFAULT_SENDER=MSMS <your_email@gmail.com>

# Twilio SMS Settings
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+1234567890

# WhatsApp (Twilio)
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Upload Settings
UPLOAD_FOLDER=app/static/uploads
MAX_CONTENT_LENGTH=16777216

# Redis (for rate limiting, optional)
REDIS_URL=redis://localhost:6379/0

# ABHA / NHA API
ABHA_CLIENT_ID=your_abha_client_id
ABHA_CLIENT_SECRET=your_abha_client_secret
ABHA_BASE_URL=https://healthidsbx.abdm.gov.in/api

# App Info
APP_NAME=Medical Store Management System
APP_VERSION=1.0.0

# Dev server bind address (default 127.0.0.1)
# HOST=127.0.0.1
